<Window x:Class="DeviceMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceMonitor.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Temperature" FontSize="14"/>
        <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1} °C}" FontSize="32"/>

        <TextBlock Text="Pressure" FontSize="14" Margin="0,16,0,0"/>
        <TextBlock Text="{Binding Pressure, StringFormat={}{0:F1} hPa}" FontSize="32"/>

        <TextBlock Text="ALARM" Foreground="Red" FontSize="24" FontWeight="Bold" Margin="0,16,0,0"
               Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</Window>
